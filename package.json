{
  "name": "qexam-teacher",
  "private": true,
  "version": "1.0.0",
  "description": "Qexam Teacher - AI-Powered Educational Worksheet Studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "assets": "node scripts/make-icons.mjs && node scripts/copy-tesseract.mjs",
    "tauri": "tauri",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.5",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@tauri-apps/cli": "^2.8.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
